# اختر auto أو openai أو gemini أو nvidia
export NABD_PROVIDER=auto

# ضع مفتاح مزود واحد على الأقل
export OPENAI_API_KEY=""
export GEMINI_API_KEY=""
export NVIDIA_API_KEY=""

# اختياري: تغيير النماذج أو مهلة الاتصال
export NABD_OPENAI_MODEL="gpt-4o-mini"
export NABD_GEMINI_MODEL="gemini-2.0-flash"
export NABD_NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
export NABD_NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"
export NABD_TIMEOUT="90"

# اختياري لمزودي OpenAI المتوافقين
